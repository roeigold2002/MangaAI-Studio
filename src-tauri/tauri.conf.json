{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaAI Studio",
  "version": "0.1.0",
  "identifier": "com.mangaai.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MangaAI Studio",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0e0f13",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' mangaimg: http://mangaimg.localhost asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Entertainment",
    "shortDescription": "Manga reader with AI Hebrew translation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../worker/mangaai_worker/": "worker/mangaai_worker/",
      "../worker/pyproject.toml": "worker/pyproject.toml",
      "../worker/uv.lock": "worker/uv.lock",
      "../resources/fonts/": "fonts/"
    },
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  }
}
